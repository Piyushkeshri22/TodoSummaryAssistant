# Local Docker Compose - MySQL
MYSQL_ROOT_PASSWORD=replace_with_a_strong_local_password

# Optional integrations
COHERE_API_KEY=
SLACK_WEBHOOK_URL=

# Backend application configuration
# For local Compose, the database password is supplied through MYSQL_ROOT_PASSWORD.
# For EC2/RDS, update these values in the EC2-local .env file.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/todo_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace_with_a_strong_database_password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
